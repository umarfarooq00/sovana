{% style %}
    #impact_scrollbar-{{ section.id }}  {
      background: {{section.settings.bg_color}};
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      {% if section.settings.section_border == 'top' %}
        border-top: 2px solid {{section.settings.border_color}};
        {% elsif section.settings.section_border == 'bottom' %}
        border-bottom: 2px solid {{section.settings.border_color}};
        {% elsif section.settings.section_border == 'top_bottom' %}
        border-top: 2px solid {{section.settings.border_color}};
        border-bottom: 2px solid {{section.settings.border_color}};
        {% else %}
        border: none;
      {% endif %}
    }
    #impact_scrollbar-{{ section.id }} h2 {
      color: {{ section.settings.font_color }};
    }
    #impact_scrollbar-{{ section.id }} .marquee {
        animation: marquee-scroll var(--scroll-duration) linear infinite;
        --scroll-duration: {{ section.settings.scroll_time }}s;
    }
    @media screen and (max-width: 991px) {
        #impact_scrollbar-{{ section.id }} {
            padding-top: {{ section.settings.padding_top_mobile }}px;
            padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        }
        #impact_scrollbar-{{ section.id }} .marquee {
            --scroll-duration: {{ section.settings.mobile_scroll_time }}s;
        }
    }
{% endstyle %}
<section class="impact_scrollbar" id="impact_scrollbar-{{ section.id }}" aria-hidden="true">
  <div class="container">
    <div class="scrollbar_wrapper">
        <div
        class="marquee {% if section.settings.bottom_line %} bottom_line_wrapper {% endif %}"
        style="--play:running; --direction:normal; --delay:0s; --iteration-count:infinite;"
        >
        {% for i in (1..20) %}
            {% for block in section.blocks %}
                <div class="bar_item" id="bar_item-{{ block.id }}">
                {% if block.settings.text != blank %}
                    <h2>{{ block.settings.text }}</h2>
                {% endif %}
                </div>
            {% endfor %}
        {% endfor %}
        </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('#impact_scrollbar-{{ section.id }} .marquee').forEach(function (marquee) {
      const duration = getComputedStyle(marquee).getPropertyValue('--scroll-duration').trim();
      marquee.style.animationDuration = duration;
      const content = marquee.innerHTML;
      marquee.innerHTML += content;
    });
  });
</script>
{% schema %}
{
  "name": "Impact Scrollbar",
  "settings": [
    {
      "type": "select",
      "id": "section_border",
      "label": "Section Border",
      "options": [
        {
          "value": "top",
          "label": "Border Top"
        },
        {
          "value": "bottom",
          "label": "Border Bottom"
        },
        {
          "value": "top_bottom",
          "label": "Border Top & Bottom"
        },
        {
          "value": "none",
          "label": "No border"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "scroll_time",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Desktop Scroll Time",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_scroll_time",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Mobile Scroll Time",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#C4F3FF"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font Color",
      "default": "#002D77"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#002D77"
    },
    {
      "type": "header",
      "content": "Section Spacing Settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "add_text",
      "name": "Add Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "BUILT BY WOMEN. SUPPORTING WOMEN."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Impact Scrollbar"
    }
  ]
}
{% endschema %}
