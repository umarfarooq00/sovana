{% style %}
    #impact_scrollbar-{{ section.id }}  {
      background: {{section.settings.bg_color}};
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
    #impact_scrollbar-{{ section.id }} h2 {
      color: {{ section.settings.font_color }};
    }
    #impact_scrollbar-{{ section.id }} .marquee {
        animation: marquee-scroll var(--scroll-duration) linear infinite;
        --scroll-duration: {{ section.settings.scroll_time }}s;
    }
    .impact_scrollbar {
      overflow: hidden;
      white-space: nowrap;
    }
    .impact_scrollbar .container {
      max-width: 100%;
      padding: 0;
    }
    .impact_scrollbar .marquee {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 35px;
    }
    .impact_scrollbar .bar_item {
      display: flex;
      align-items: center;
      gap: 15px;
      align-self: stretch;
    }
    .impact_scrollbar h2 {
      text-align: center;
      font-style: normal;
      font-weight: 400;
      font-size: 20px;
      line-height: normal;
    }
    @keyframes marquee-scroll {
      0% {
          transform: translateX(0%);
      }
      100% {
          transform: translateX(-100%);
      }
    }
    @media screen and (max-width: 991px) {
        #impact_scrollbar-{{ section.id }} .marquee {
            --scroll-duration: {{ section.settings.mobile_scroll_time }}s;
        }
    }
{% endstyle %}
<section class="impact_scrollbar" id="impact_scrollbar-{{ section.id }}" aria-hidden="true">
  <div class="container">
    <div class="scrollbar_wrapper">
        <div
        class="marquee {% if section.settings.bottom_line %} bottom_line_wrapper {% endif %}"
        style="--play:running; --direction:normal; --delay:0s; --iteration-count:infinite;"
        >
        {% for i in (1..20) %}
            {% for block in section.blocks %}
                <div class="bar_item" id="bar_item-{{ block.id }}">
                {% if block.settings.text != blank %}
                    <h2>{{ block.settings.text }}</h2>
                {% endif %}
                </div>
            {% endfor %}
        {% endfor %}
        </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('#impact_scrollbar-{{ section.id }} .marquee').forEach(function (marquee) {
      const duration = getComputedStyle(marquee).getPropertyValue('--scroll-duration').trim();
      marquee.style.animationDuration = duration;
      const content = marquee.innerHTML;
      marquee.innerHTML += content;
    });
  });
</script>
{% schema %}
{
  "name": "Impact Scrollbar",
  "settings": [
    {
      "type": "range",
      "id": "scroll_time",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Desktop Scroll Time",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_scroll_time",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Mobile Scroll Time",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#C9A96E"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing Settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "add_text",
      "name": "Add Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "BUILT BY WOMEN. SUPPORTING WOMEN."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Impact Scrollbar"
    }
  ]
}
{% endschema %}
