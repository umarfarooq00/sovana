{%- style -%}
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 99;
  }
  #marquee_main-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
    width: 100%;
    overflow: hidden;
  }

  /* ── Track ─────────────────────────────────────────────── */
  #marquee_main-{{ section.id }} .marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: {{ section.settings.gap }}px;
    animation: marquee-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
  }

  #marquee_main-{{ section.id }} .marquee__track:hover {
    animation-play-state: {{ section.settings.pause_on_hover }};
  }

  /* ── Items ─────────────────────────────────────────────── */
  #marquee_main-{{ section.id }} .marquee__item {
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: {{ section.settings.font_color }};
    font-size: {{ section.settings.font_size }}px;
    font-weight: normal;
    line-height: 1;
  }

  /* ── Separator ─────────────────────────────────────────── */
  #marquee_main-{{ section.id }} .marquee__sep {
    display: inline-flex;
    align-items: center;
    margin-left: {{ section.settings.gap }}px;
    opacity: 0.6;
    color: {{ section.settings.font_color }};
  }

  /* ── Hide sep on last item of each set ─────────────────── */
  #marquee_main-{{ section.id }} .marquee__set:last-child .marquee__item:last-child .marquee__sep {
    display: none;
  }

  /* ── Animation ─────────────────────────────────────────── */
  @keyframes marquee-scroll-{{ section.id }} {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 767px) {
    #marquee_main-{{ section.id }} .marquee__item {
      font-size: {{ section.settings.font_size | minus: 2 }}px;
    }
  }
{%- endstyle -%}

<section class="marquee_main" id="marquee_main-{{ section.id }}">
  <div class="marquee__track">

    {%- comment -%} First set ─────────────────────────────── {%- endcomment -%}
    <div class="marquee__set">
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <span class="marquee__item">
            {{- block.settings.text -}}
            <span class="marquee__sep">{{ section.settings.separator }}</span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Duplicate set for seamless loop ─────────── {%- endcomment -%}
    <div class="marquee__set" aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <span class="marquee__item">
            {{- block.settings.text -}}
            <span class="marquee__sep">{{ section.settings.separator }}</span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Item Gap",
      "default": 40
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator Symbol",
      "default": "✦"
    },
    {
      "type": "select",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "options": [
        { "value": "paused",  "label": "Yes" },
        { "value": "running", "label": "No" }
      ],
      "default": "paused"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "BG Color",
      "default": "#C9A96E"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    }
  ],
  "blocks": [
    {
      "name": "Add Text",
      "type": "add_text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New Season Arrivals"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "add_text" },
        { "type": "add_text" },
        { "type": "add_text" },
        { "type": "add_text" }
      ]
    }
  ]
}
{% endschema %}